{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "SecretKey": "",
    "AccessTokenExpireMinutes": "15",
    "RefreshTokenExpireDays": "7"
  },
  "Cors": {
    "Origins": ""
  },
  "Firebase": {
    "CredentialFile": ""
  },
  "Google": {
    "WebClientId": ""
  },
  "Uploads": {
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      ".heif"
    ],
    "BaseUrl": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8000"
      }
    }
  },
  "Jobs": {
    "BookingExpiry": {
      "Enabled": false,
      "IntervalSeconds": 300,
      "BatchSize": 200,
      "WindowMinutes": 120,
      "SlotBufferMinutes": 30,
      "MinimumMinutes": 10
    }
  }
}
